ENV_HTTP_ADDR=:8080
ENV_GRPC_ADDR=:9090
ENV_POSTGRES_DSN=postgres://identity:password@localhost:5432/identity?sslmode=disable
ENV_OIDC_CONFIG_PATH=config/oidc.yaml
ENV_TOKEN_ISSUER=beaesthetic-identity
ENV_TOKEN_TTL=5m
# Generate once with: openssl rand -base64 64 | tr '+/' '-_' | tr -d '='
ENV_TOKEN_ACTIVE_KEY_ID=2026-09
ENV_TOKEN_PRIVATE_KEY_B64=
# JSON map of retired public keys; the active public key is derived from the private key.
ENV_TOKEN_VERIFY_KEYS_JSON={}
# Shared only with APISIX / trusted internal callers. Prefer mTLS in production.
ENV_INTERNAL_API_KEY=
