ENV_APP_NAME=appointment-service-local
ENV_HTTP_ADDR=:8080

ENV_POSTGRES_DSN=postgres://appointment:appointment@localhost:5432/appointment?sslmode=disable
ENV_MONGO_URI=mongodb://localhost:27017
ENV_MONGO_DATABASE=appointments-v2-local

ENV_REMOTE_CUSTOMER__URL=http://localhost:8081
ENV_REMOTE_SCHEDULER__URL=http://localhost:8083
ENV_REMOTE_NOTIFICATION__URL=http://localhost:8084

ENV_RABBITMQ_URL=amqp://guest:guest@localhost:5672/
ENV_RABBITMQ_SCHEDULER__QUEUE=reminders-times-up
ENV_RABBITMQ_APPOINTMENT__INTERNAL__JOB__QUEUE=beaesthetic.appointments.internal.job
ENV_RABBITMQ_NOTIFICATION__CONFIRM__QUEUE=NotificationConfirmQueue

ENV_REMINDER_TRIGGER__BEFORE=24h
ENV_REMINDER_IMMEDIATE__SEND__THRESHOLD=2m
ENV_REMINDER_NO__SEND__THRESHOLD=30m